{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bugfender/bugfender-skills/schemas/claude-plugin.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "displayName", "version", "description", "author", "homepage", "repository", "license", "keywords", "skills", "mcpServers"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "homepage": { "type": "string", "format": "uri" },
    "repository": { "type": "string", "format": "uri" },
    "documentationUrl": { "type": "string", "format": "uri" },
    "supportUrl": { "type": "string", "format": "uri" },
    "privacyPolicyUrl": { "type": "string", "format": "uri" },
    "termsOfServiceUrl": { "type": "string", "format": "uri" },
    "license": { "type": "string", "const": "Apache-2.0" },
    "keywords": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "skills": { "const": "./skills/" },
    "mcpServers": { "const": "./.mcp.json" },
    "metadata": { "type": "object" }
  }
}
